# Optional path to an ONNX model. Relative paths are resolved under backend/.
# The model downloads to backend/models/wastewise-yolo.onnx by default.
# VISION_MODEL_PATH=models/wastewise-yolo.onnx

# Comma-separated browser origins allowed to call the API and connect to /ws.
# Defaults to the local Next.js origins below when unset. Replace/add the
# deployed frontend origin after its hosting URL is known; do not use '*'.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://smart-recycling-agent-frontend-419humuf5.vercel.app

# Recycling Intelligence Agent Configuration (Optional)
# When AGENT_ENABLED is false or credentials are unset, the backend uses
# grounded deterministic fallback for operational queries.
AGENT_ENABLED=false
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_API_KEY=your-api-key-here
# AGENT_MODEL=gpt-4o-mini
# AGENT_TIMEOUT_SECONDS=30.0
# AGENT_MAX_TOOL_ROUNDS=5
