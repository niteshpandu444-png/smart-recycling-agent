# ==============================================================================
# Smart Recycling Agent — Frontend Environment Configuration
# ==============================================================================
# IMPORTANT:
# 1. Do NOT commit private tokens, API keys, or backend secrets here.
# 2. Variables prefixed with NEXT_PUBLIC_ are bundled into client-side code.
#
# Laptop Local Development:
# For local testing on the same laptop running the backend:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Production deployments use frontend/.env.production (also set these in Vercel):
# NEXT_PUBLIC_API_BASE_URL=https://smart-recycling-agent-production.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://smart-recycling-agent-production.up.railway.app/ws

# Developer / Debug Mode:
# When set to true, displays debug metadata in the UI (e.g. active idempotency keys).
# Default: false
NEXT_PUBLIC_DEV_MODE=false

# Mobile Device / Phone Testing over Local Area Network (LAN):
# A mobile phone browsing the app CANNOT connect to 'localhost' (as localhost on
# the phone points to the phone itself, not your laptop backend).
#
# Replace YOUR_LAPTOP_LAN_IP with your laptop's local IP address (e.g., 192.168.1.150):
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.150:8000
# NEXT_PUBLIC_WS_URL=ws://192.168.1.150:8000/ws
#
# Browser Camera Security Note:
# Mobile browsers require a secure context (HTTPS) or 'localhost' to grant native
# camera stream access (getUserMedia). When accessing via HTTP on a LAN IP:
# - Use an HTTPS reverse proxy (e.g., ngrok, local-ssl-proxy, or mkcert) for native camera access.
# - If running over unencrypted HTTP LAN, the built-in file upload fallback (camera capture via file input)
#   will automatically be used to allow capturing photos directly from the phone camera.
# ==============================================================================
